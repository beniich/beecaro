{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with roles and enterprise settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "role": { "type": "string", "enum": ["admin", "facility_manager", "technician", "tenant", "viewer"] },
        "domain": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "role"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Enterprise security and operation audit trail",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "action": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "details": { "type": "string", "maxLength": 2048 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action", "timestamp"]
    },
    "ApiKey": {
      "title": "ApiKey",
      "description": "Secure API key with permission scopes (Read, Write, Admin) and revocation status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "keyPrefix": { "type": "string", "maxLength": 64 },
        "keyMasked": { "type": "string", "maxLength": 128 },
        "scopes": {
          "type": "array",
          "items": { "type": "string", "enum": ["read", "write", "admin"] }
        },
        "status": { "type": "string", "enum": ["active", "revoked"] },
        "environment": { "type": "string", "enum": ["production", "staging", "development"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string" },
        "revokedAt": { "type": "string" },
        "lastUsedAt": { "type": "string" },
        "usageCount": { "type": "number" }
      },
      "required": ["id", "userId", "name", "keyPrefix", "scopes", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user account and role details"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trail entries for facility actions"
    },
    "/api_keys/{keyId}": {
      "schema": "ApiKey",
      "description": "Stores generated API keys with scopes and revocation state"
    }
  }
}
